---
import ShowcaseImage from "./ShowcaseImage.astro";

interface Props {
  title: string;
  image: string;
  description?: string;
  date?: string;
  link?: string;
  visitLabel?: string;
  /** PhotoSwipe 与无障碍：如「点击放大预览」 */
  previewHint?: string;
}

const {
  title,
  image,
  description,
  date,
  link,
  visitLabel = "Link",
  previewHint,
} = Astro.props;

const imgClass =
  "showcase-gallery-lightbox w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03] cursor-zoom-in";
---

<div
  class="showcase-gallery-card group flex flex-col h-full rounded-xl overflow-hidden border border-[var(--line-divider)] bg-[var(--card-bg)] shadow-sm hover:shadow-md hover:border-[var(--primary)]/35 transition-all duration-300"
>
  <div
    class="relative aspect-[4/3] overflow-hidden bg-black/[0.06] dark:bg-white/[0.06]"
    role="presentation"
  >
    <ShowcaseImage
      src={image}
      alt={title}
      class={imgClass}
      hint={previewHint}
    />
  </div>
  <div class="p-4 flex flex-col flex-1 gap-1 min-w-0">
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-bold text-base text-black/90 dark:text-white/90 leading-snug">
        {title}
      </h3>
      {date && (
        <time class="text-xs text-black/40 dark:text-white/40 shrink-0 tabular-nums">
          {date}
        </time>
      )}
    </div>
    {description && (
      <p class="text-sm text-black/55 dark:text-white/55 line-clamp-3 flex-1">
        {description}
      </p>
    )}
    {
      link && (
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 inline-flex items-center text-xs font-medium text-[var(--primary)] hover:opacity-90"
        >
          <span>{visitLabel}</span>
          <svg
            class="ml-1 w-3.5 h-3.5 transform group-hover:translate-x-0.5 transition-transform"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
            />
          </svg>
        </a>
      )
    }
  </div>
</div>

<style>
  .showcase-gallery-card {
    transform: translateY(0);
  }
  .showcase-gallery-card:hover {
    transform: translateY(-3px);
  }
</style>
