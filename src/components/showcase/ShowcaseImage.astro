---
import { Image } from "astro:assets";
import path from "node:path";
import { url } from "../../utils/url-utils";

interface Props {
  src: string;
  alt: string;
  class?: string;
  /** 悬停提示与无障碍标签（如「点击放大预览」） */
  hint?: string;
}

const { src, alt, class: className = "", hint } = Astro.props;

const isRemote =
  src.startsWith("http") ||
  src.startsWith("https") ||
  src.startsWith("//");
const isPublic = src.startsWith("/");

let localImg: ImageMetadata | undefined;
if (!isRemote && !isPublic) {
  const files = import.meta.glob<ImageMetadata>("../../assets/showcase/**", {
    import: "default",
  });
  const normalizedPath = path
    .normalize(path.join("../../assets/showcase/", src))
    .replace(/\\/g, "/");
  const loader = files[normalizedPath];
  if (loader) {
    localImg = await loader();
  }
}
---

{
  isRemote && (
    <img
      src={src}
      alt={alt}
      class={className}
      loading="lazy"
      decoding="async"
      title={hint}
      aria-label={hint ?? alt}
    />
  )
}
{
  isPublic && (
    <img
      src={url(src)}
      alt={alt}
      class={className}
      loading="lazy"
      decoding="async"
      title={hint}
      aria-label={hint ?? alt}
    />
  )
}
{
  !isRemote && !isPublic && localImg && (
    <Image
      src={localImg}
      alt={alt}
      class={className}
      title={hint}
      aria-label={hint ?? alt}
    />
  )
}
{
  !isRemote && !isPublic && !localImg && (
    <div
      class:list={[
        className,
        "flex items-center justify-center bg-[var(--btn-regular-bg)] text-sm text-black/40 dark:text-white/40 min-h-[6rem]",
      ]}
    >
      ?
    </div>
  )
}
